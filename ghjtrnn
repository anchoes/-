from telegram import Update, ReplyKeyboardMarkup, KeyboardButton
from telegram.ext import Application, CommandHandler, MessageHandler, filters, ContextTypes

BOT_TOKEN = "7374942440:AAH7WORA6g96LFFkg_vPSoMECkMNKvhxyeY"

# Клавиатура с кнопками
def get_main_keyboard():
    keyboard = [
        [KeyboardButton("📊 Статистика"), KeyboardButton("ℹ️ Информация")],
        [KeyboardButton("⚙️ Настройки"), KeyboardButton("📞 Связаться")]
    ]
    return ReplyKeyboardMarkup(keyboard, resize_keyboard=True)

async def start_command(update: Update, context: ContextTypes.DEFAULT_TYPE):
    keyboard = get_main_keyboard()
    await update.message.reply_text(
        "Добро пожаловать! Выберите действие:",
        reply_markup=keyboard
    )

async def handle_message(update: Update, context: ContextTypes.DEFAULT_TYPE):
    text = update.message.text
    
    if text == "📊 Статистика":
        await update.message.reply_text("Статистика: 100 пользователей")
    elif text == "ℹ️ Информация":
        await update.message.reply_text("Это информационный бот")
    elif text == "⚙️ Настройки":
        await update.message.reply_text("Настройки бота")
    elif text == "📞 Связаться":
        await update.message.reply_text("Контакты: @anchoes")
    else:
        await update.message.reply_text("Используйте кнопки для навигации")

def main():
    application = Application.builder().token(BOT_TOKEN).build()
    
    application.add_handler(CommandHandler("start", start_command))
    application.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, handle_message))
    
    print("Бот запущен...")
    application.run_polling()

if __name__ == "__main__":
    main()
